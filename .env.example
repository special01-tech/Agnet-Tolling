# =====================================================================
# Configuration des variables d'environnement - Agent IA Personnel
# Copiez ce fichier vers .env : cp .env.example .env
# =====================================================================

# 1. Modèle IA (OpenRouter - GPT-4o)
OPENROUTER_API_KEY=sk-or-v1-votre_cle_openrouter_ici
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=openai/gpt-4o

# 2. Recherche Web en direct (Tavily)
TAVILY_API_KEY=tvly-votre_cle_tavily_ici

# 3. Météo (OpenWeather - offre gratuite)
OPENWEATHER_API_KEY=votre_cle_openweather_ici
# Rétrocompatibilité :
# GETWEATHER_API_KEY=votre_cle_openweather_ici

# 4. Email SMTP & Sécurité Liste Blanche
ALLOWED_EMAIL_RECIPIENT=gabinsokindji@gmail.com
SMTP_EMAIL=votre_adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_ici
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# 5. Notion API
NOTION_API_KEY=secret_votre_cle_notion_ici

# 6. Google Calendar & Google Drive (OAuth 2.0 Cloud)
GOOGLE_CLIENT_ID=votre_google_client_id_ici
GOOGLE_CLIENT_SECRET=votre_google_client_secret_ici
GOOGLE_REFRESH_TOKEN=votre_google_refresh_token_obtenu_ici
